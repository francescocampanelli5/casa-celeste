rules_version = '2';

// Casa Celeste — regole di sicurezza Firebase Storage.
// Foto delle stanze caricate dalla dashboard: chiunque può vederle (per
// mostrarle sul sito pubblico), solo il proprietario autenticato può
// caricarne o cancellarne.
//
// App Check (request.app != null) TEMPORANEAMENTE RIMOSSO da tutte le regole
// qui sotto (31/07, richiesta esplicita dell'utente): lo scambio del token
// reCAPTCHA v3 → App Check falliva in produzione con "App attestation
// failed", bloccando ogni upload autenticato dalla dashboard. Riabilitare
// (rimettere "&& request.app != null" su ogni regola) SOLO dopo aver
// verificato in Firebase Console → App Check che il provider reCAPTCHA v3
// sia registrato con la chiave/dominio corretti.
service firebase.storage {
  match /b/{bucket}/o {

    // isOwner(): vedi firestore.rules per il perché — prima di 01/08 tutte
    // le regole sotto controllavano solo "request.auth != null", chiunque
    // avesse un account Firebase autenticato poteva caricare/cancellare
    // foto e leggere i documenti d'identità ospiti.
    function isOwner() {
      return request.auth != null && request.auth.token.role == 'owner';
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /commons/{commonId}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /monoSlides/{slideId}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /site/{fileName=**} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ======================================================================
    // Affittacamere — stesso progetto Firebase, path separati (tourism-*).
    // ======================================================================

    match /tourism-rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /tourism-commons/{commonId}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /tourism-monoSlides/{slideId}/{fileName} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /tourism-site/{fileName=**} {
      allow read: if true;
      allow write: if isOwner()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Area TEMPORANEA per la foto del documento d'identità: scrittura
    // pubblica limitata (dimensione/tipo), ma MAI leggibile pubblicamente —
    // la Cloud Function submitGuestDocuments la sposta subito nell'area
    // definitiva sottostante ed elimina l'originale qui. Se un visitatore
    // carica un file senza mai completare l'invio, resta solo qui (ripulito
    // periodicamente da scripts/cleanup-guest-docs.js), mai nell'area
    // definitiva. App Check (che richiedeva che l'upload passi da
    // ospiti.html/il bot Telegram, non da uno script esterno che spamma file
    // a caso in quest'area pubblica) TEMPORANEAMENTE RIMOSSO come sopra:
    // questo percorso resta scrittura pubblica senza login, protetta solo da
    // dimensione/tipo file finché l'App Check non viene riabilitato — quello
    // da riabilitare con più priorità, appena sistemata la console.
    match /tourism-guest-docs-tmp/{bookingId}/{fileName} {
      allow read: if isOwner();
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
    }

    // Area DEFINITIVA dei documenti d'identità ospiti — dati sensibili, MAI
    // pubblica: solo il proprietario autenticato può leggerla. La scrittura
    // avviene solo lato server (Cloud Function/Admin SDK, che bypassa
    // queste regole), mai dal client.
    match /tourism-guest-docs/{bookingId}/{fileName} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Backup settimanale (prenotazioni, documenti ospiti, stanze,
    // impostazioni) — scritto solo dallo script backup-export.js via Admin
    // SDK (bypassa queste regole), mai dal client. Dati sensibili: lettura
    // riservata al proprietario, come i documenti d'identità sopra.
    match /tourism-backups/{fileName} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Registro Excel di tutte le prenotazioni + dati ospiti (vedi
    // functions/bookings-excel-export.js) — rigenerato automaticamente a ogni
    // scrittura su prenotazioni/documenti ospiti, mai scritto dal client.
    // Stessi dati sensibili dei documenti d'identità sopra: lettura riservata
    // al proprietario. In pratica il download passa da getBookingsExcelExport
    // (Cloud Function onCall, stesso controllo isOwner) invece che da qui
    // direttamente, ma la regola resta come seconda barriera.
    match /tourism-exports/{fileName} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
