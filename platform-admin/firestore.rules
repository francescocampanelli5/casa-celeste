rules_version = '2';

// Piattaforma di controllo SaaS (celeste-saas-control) — regole Firestore.
// Un'unica collezione (tenants), leggibile e scrivibile SOLO dal
// proprietario della piattaforma. Non contiene mai dati di prenotazioni o
// ospiti — solo anagrafica clienti, URL delle loro Cloud Functions e il
// segreto condiviso usato per le 3 azioni definite in functions/index.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.role == 'owner';
    }
    match /tenants/{tenantId} {
      allow read, write: if isOwner();
    }
    // Registro delle 3 azioni sensibili (attiva/disattiva servizio, crea
    // proprietario, reset password) — scritto SOLO da platform-admin/functions
    // (Admin SDK, bypassa questa regola) subito dopo ogni azione riuscita, mai
    // dal client: anche il proprietario può solo leggerlo, non modificarlo o
    // cancellarlo, per restare uno storico affidabile di cosa è stato fatto.
    match /auditLog/{entryId} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
