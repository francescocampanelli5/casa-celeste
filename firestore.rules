rules_version = '2';

// Casa Celeste — regole di sicurezza Firestore.
// rooms: chiunque può leggere (per mostrare lo stato delle stanze sul sito pubblico),
//        solo il proprietario autenticato (dashboard) può modificare.
// bookings: chiunque può CREARE una prenotazione (dal modulo del sito),
//           ma solo il proprietario autenticato può leggerle, aggiornarle o cancellarle.
//
// App Check (request.app != null) TEMPORANEAMENTE RIMOSSO da tutte le regole
// qui sotto (31/07, richiesta esplicita dell'utente): lo scambio del token
// reCAPTCHA v3 → App Check falliva in produzione con "App attestation
// failed" (dominio/chiave non collegati correttamente in console Firebase),
// bloccando OGNI scrittura autenticata — inclusa l'intera dashboard
// (stanze, prenotazioni, impostazioni) sia qui sia in /affittacamere.
// Riabilitare (rimettere "&& request.app != null" su ogni regola) SOLO dopo
// aver verificato in Firebase Console → App Check che il provider reCAPTCHA
// v3 sia registrato con la chiave/dominio corretti.
service cloud.firestore {
  match /databases/{database}/documents {

    // isOwner(): prima di 01/08 tutte le regole sotto controllavano solo
    // "request.auth != null" — QUALSIASI account Firebase autenticato (non
    // solo il proprietario) aveva scrittura piena su stanze/prenotazioni/
    // impostazioni e lettura sui documenti d'identità ospiti. Il custom
    // claim "role: owner" viene impostato una sola volta sull'account del
    // proprietario (vedi functions/, bootstrap rimosso dopo l'uso); solo chi
    // ha quel claim passa questo controllo.
    function isOwner() {
      return request.auth != null && request.auth.token.role == 'owner';
    }

    // Kill switch piattaforma SaaS (celeste-saas-control) lato regole: senza
    // questo, un proprietario disattivato per mancato pagamento potrebbe
    // comunque gestire stanze/prenotazioni/impostazioni scrivendo DIRETTO su
    // Firestore dalla dashboard (bypassa le Cloud Function/assertServiceEnabled
    // in functions/index.js, che protegge solo le azioni che passano da lì).
    // Stesso documento platform_control/status letto dal frontend — vedi
    // affittacamere/js/firebase-init.js. Nessun comportamento cambia finché
    // non esiste ancora (deploy pre-SaaS) o non è mai stato disattivato.
    function serviceEnabled() {
      return !exists(/databases/$(database)/documents/platform_control/status) ||
        get(/databases/$(database)/documents/platform_control/status).data.enabled != false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /commons/{commonId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /monoSlides/{slideId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 200
                    && request.resource.data.roomLabel is string
                    && request.resource.data.status == 'nuovo';
      allow read, update, delete: if isOwner();
    }

    // ======================================================================
    // Affittacamere (locazione turistica breve termine) — stesso progetto
    // Firebase, collezioni separate con prefisso tourism_. Vedi
    // affittacamere/js/firebase-init.js e functions/index.js.
    // ======================================================================

    match /tourism_rooms/{roomId} {
      allow read: if true;
      allow write: if isOwner() && serviceEnabled();
    }
    match /tourism_commons/{commonId} {
      allow read: if true;
      allow write: if isOwner() && serviceEnabled();
    }
    match /tourism_monoSlides/{slideId} {
      allow read: if true;
      allow write: if isOwner() && serviceEnabled();
    }
    match /tourism_reviews/{reviewId} {
      allow read: if true;
      allow write: if isOwner() && serviceEnabled();
    }
    match /tourism_settings/{settingId} {
      allow read: if true;
      allow write: if isOwner() && serviceEnabled();
    }

    // Stato "attivo/disabilitato" della piattaforma SaaS centrale
    // (celeste-saas-control), vedi functions/platform-control.js. Lettura
    // pubblica: sia il sito pubblico che la dashboard leggono questo
    // documento al boot per decidere se mostrare l'app normale o la pagina
    // "Servizio disabilitato". Scrittura SEMPRE negata al client: lo
    // aggiorna solo platformSetStatus tramite Admin SDK, che bypassa questa
    // regola — nessun utente, nemmeno il proprietario, può auto-riattivarsi
    // scrivendo direttamente da qui.
    match /platform_control/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Documento SEPARATO da tourism_settings apposta: quello sopra è
    // leggibile pubblicamente (il sito pubblico legge telefono/orari da
    // lì), quindi credenziali sensibili (Alloggiati Web/ISTAT/PayTourist)
    // non possono starci — chiunque le leggerebbe dalla console del
    // browser. Qui invece lettura e scrittura sono SOLO del proprietario.
    match /tourism_settingsPrivate/{settingId} {
      allow read: if isOwner();
      allow write: if isOwner() && serviceEnabled();
    }

    // Manutenzioni stanza: nessuna lettura pubblica necessaria (il sito
    // pubblico legge solo tourism_rooms.blockedRanges per la disponibilità,
    // mai questa collection direttamente); solo il proprietario (dashboard
    // o bot Telegram via Admin SDK, che bypassa comunque queste regole)
    // crea/legge/modifica/cancella.
    match /tourism_maintenance/{maintenanceId} {
      allow read: if isOwner();
      allow write: if isOwner() && serviceEnabled();
    }

    // La creazione di una prenotazione passa SOLO dalla Cloud Function
    // createBooking (transazione anti-doppia-prenotazione + validazione
    // completa, vedi functions/index.js): l'Admin SDK che usa bypassa
    // comunque queste regole, quindi qui il client pubblico non può mai
    // scrivere direttamente — evita di aggirare la transazione.
    match /tourism_bookings/{bookingId} {
      allow create: if false;
      allow read: if isOwner();
      allow update, delete: if isOwner() && serviceEnabled();
    }

    // Messaggi lasciati dal widget di assistenza — la scrittura passa SOLO
    // dalla Cloud Function submitAssistMessage (validazione completa lato
    // server, l'Admin SDK bypassa comunque queste regole); la dashboard
    // (proprietario autenticato) legge/aggiorna/cancella direttamente.
    match /tourism_assistMessages/{messageId} {
      allow create: if false;
      allow read: if isOwner();
      allow update, delete: if isOwner() && serviceEnabled();
    }

    // Contatore di click sulle card "Consigli & dintorni" — la scrittura
    // passa SOLO dalla Cloud Function logRecClick (l'Admin SDK bypassa
    // comunque queste regole); il client pubblico non deve mai poter
    // leggere né alterare i contatori.
    match /tourism_recsClicks/{clickId} {
      allow create: if false;
      allow read: if isOwner();
      allow update, delete: if isOwner() && serviceEnabled();
    }

    // Documenti d'identità degli ospiti — dati sensibili, MAI leggibili né
    // scrivibili dal client pubblico: la scrittura passa solo dalla Cloud
    // Function submitGuestDocuments (verifica token + validazione completa
    // lato server, l'Admin SDK bypassa queste regole).
    match /tourism_guestDocuments/{bookingId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Ospiti già identificati in un soggiorno precedente (chiave hash, mai
    // il documento in chiaro) — riconosciuti in automatico dalla Cloud
    // Function submitGuestDocuments/markIdentityVerified, mai scritti dal
    // client direttamente.
    match /tourism_verifiedGuests/{guestKey} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Firma OTP del contratto di locazione (FES) — hash dell'OTP e audit
    // trail (IP/timestamp/email/user-agent al momento della firma). Stesso
    // pattern di tourism_guestDocuments: mai leggibile/scrivibile dal
    // client pubblico, la scrittura passa solo dalle Cloud Function
    // requestSignatureOtp/verifySignatureOtp (Admin SDK, bypassa queste
    // regole). Se il client potesse leggere questo documento vedrebbe
    // l'hash dell'OTP: nessun problema di per sé (non è invertibile), ma
    // meglio non esporlo comunque.
    match /tourism_guestSignatures/{bookingId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Sessioni del wizard bot Telegram (functions/telegram-bot.js) — solo
    // l'Admin SDK della Cloud Function le scrive (bypassa comunque queste
    // regole); dichiarate qui solo per coerenza/difesa in profondità, come
    // tourism_guestDocuments/tourism_verifiedGuests sopra.
    match /tourism_botSessions/{chatId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Contatori di rate limiting per-IP (functions/rate-limit.js) — solo
    // l'Admin SDK delle Cloud Function li legge/scrive (bypassa comunque
    // queste regole); mai accessibili dal client, nemmeno in lettura, per
    // non rivelare IP/conteggi di altri visitatori.
    match /rateLimits/{key} {
      allow read, write: if false;
    }

    // Lock anti-doppio-uso di un paymentIntentId (vedi claimPaymentIntentTx
    // in functions/booking-logic.js): scritto solo dentro la transazione
    // che crea la prenotazione, mai dal client.
    match /tourism_usedPaymentIntents/{intentId} {
      allow read, write: if false;
    }
  }
}
